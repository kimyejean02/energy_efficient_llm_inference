
universe = vanilla

executable = /bin/bash
arguments = llm_energy_gpu.sh

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Input files
transfer_input_files = llm_energy_gpu.sh, llm_energy_gpu.py, benchmark_prompts.csv

# Output files
transfer_output_files = llm_energy_results.csv, mmlu_energy_repeats.csv, mmlu_energy_per_prompt.csv, mmlu_energy_summary.csv, llm_energy_results_graded.csv, llm_energy_summary.csv

# Resource requests
request_gpus = 1
request_cpus = 4
request_memory = 24GB
request_disk = 20GB

# GPU requirements
requirements = InMastodon && regexp("eldar", Name) && regexp("GTX 1080 Ti", CUDADeviceName)

# Job output
output = llm_energy_gpu.out
error = llm_energy_gpu.err
log = llm_energy_gpu.log

+GPUJob = true
+Group = "GRAD"
+Project = "INSTRUCTIONAL"
+ProjectDescription = "GPU script for energy and latency measurements of Qwen LLM inference"

notification = Complete
notify_user = ishajannu@utexas.edu

queue
