universe = vanilla

executable = /bin/bash
arguments = llm_energy_v4.sh

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Input files
transfer_input_files = llm_energy_v4.sh, llm_energy_v4.py, benchmark_v4.csv

# Output: one tarball with every result file (created even if the job crashes).
transfer_output_files = results_v4_full.tar.gz

# Checkpoints on scratch let a resubmitted job resume where it stopped.

# Resource requests
request_gpus = 1
request_cpus = 4
request_memory = 24GB
request_disk = 20GB

# GPU requirements
requirements = InMastodon && regexp("eldar", Name) && regexp("GTX 1080 Ti", CUDADeviceName)

# Job output
output = llm_energy_v4.out
error = llm_energy_v4.err
log = llm_energy_v4.log
# Send stdout/stderr back while the job runs, so `tail -f` shows progress.
stream_output = True
stream_error = True

+GPUJob = true
# CHECK: UTCS uses this to classify jobs. If you are an undergraduate, this may
# need to be "UNDER" instead of "GRAD"; confirm with UTCS help/docs.
+Group = "GRAD"
+Project = "INSTRUCTIONAL"
+ProjectDescription = "GPU energy and quality of specialized Qwen models (v4 additions)"

notification = Complete
notify_user = ishajannu@utexas.edu

queue
