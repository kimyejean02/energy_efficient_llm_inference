# Short end-to-end test of every stage (about 10 minutes once models are cached).
universe = vanilla

executable = /bin/bash
arguments = llm_energy_gpu.sh smoke

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Input files
transfer_input_files = llm_energy_gpu.sh, llm_energy_gpu.py, benchmark_prompts_v3.csv

# Output: one tarball with every result file (created even if the job crashes).
transfer_output_files = results_smoke.tar.gz

# Optional: run only some stages (infer, repeats, grade, router, live), e.g. to split
# a long run into two jobs. Checkpoints on scratch let a resubmitted job resume.
# environment = "STAGES=infer,repeats"

# Resource requests
request_gpus = 1
request_cpus = 4
request_memory = 24GB
request_disk = 20GB

# GPU requirements
requirements = InMastodon && regexp("eldar", Name) && regexp("GTX 1080 Ti", CUDADeviceName)

# Job output
output = llm_energy_v3_smoke.out
error = llm_energy_v3_smoke.err
log = llm_energy_v3_smoke.log
# Send stdout/stderr back while the job runs, so `tail -f` shows progress.
stream_output = True
stream_error = True

+GPUJob = true
# CHECK: UTCS uses this to classify jobs. If you are an undergraduate, this may
# need to be "UNDER" instead of "GRAD"; confirm with UTCS help/docs.
+Group = "GRAD"
+Project = "INSTRUCTIONAL"
+ProjectDescription = "GPU energy, quality, and routing measurements for Qwen LLM inference"

notification = Complete
notify_user = ishajannu@utexas.edu

queue
