def last(arr, x):
    low = 0
    high = len(arr) - 1
    result = -1
    
    while low <= high:
        mid = (low + high) // 2
        
        if arr[mid] >= x:
            result = mid
            high = mid - 1
        else:
            low = mid + 1
            
    return result
