def shell_sort(arr):
    n = len(arr)
    gap = n // 2

    while gap > 0:
        for i in range(gap, n):
            temp = arr[i]
            j = i - gap

            while j >= 0 and temp < arr[j]:
                arr[j + gap] = arr[j]
                j -= gap

            arr[j + gap]
