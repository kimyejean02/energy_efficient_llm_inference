Answer: def max_sum_increasing_subseq(nums, i, k, n):
    dp = [0] * (n + 1)
    dp[i] = nums[i]
    
    for j in range(i + 1, n):
        if j >= k:
            dp[j] = max(dp[j], dp[j - k] + nums[j])
        else:
            dp[j] = max(dp[j], nums[j])
    
    return max(dp)
