universe = vanilla
executable = run_gpu_test.sh

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = llm_energy_test.py, wildchat_benchmark.csv
transfer_output_files = llm_energy_results.csv

# Ask HTCondor for one GPU and restrict placement to UTCS's documented
# eldar GPU hosts. Confirm the pool's GPU ClassAds before submitting.
request_cpus = 4
request_memory = 24GB
request_disk = 20GB
request_gpus = 1
requirements = InMastodon && regexp("eldar", Name)

output = llm_energy_test.out
error = llm_energy_test.err
log = llm_energy_test.log

# Replace with UNDER or GRAD as appropriate for your UTCS account.
+Group = "REPLACE_WITH_UNDER_OR_GRAD"
+Project = "INSTRUCTIONAL"
+ProjectDescription = "GPU smoke test for energy and latency measurements of Qwen LLM inference"

notification = never
queue
